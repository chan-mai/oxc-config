{
	"compilerOptions": {
		"target": "es2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"declaration": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"noEmit": true
	},
	"include": ["src", "test", "*.config.ts"],
	"exclude": ["test/fixtures"]
}
